<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Richiesto da Android 13+ per mostrare notifiche (incluso il promemoria persistente) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Per ripostare il promemoria in notifica dopo un riavvio del telefono (il sistema lo
         elimina insieme a tutte le notifiche in sospeso durante lo spegnimento) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Consente di risolvere l'app di riconoscimento vocale su Android 11+ (package visibility) -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ListaSpesa">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ListaSpesa">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ricevi il testo condiviso da WhatsApp (o da qualunque altra app) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Passa alla fotocamera di sistema il file dove scrivere lo scatto, senza
             esporre la memoria privata dell'app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Riceve il tocco sulle righe della notifica persistente (funziona anche ad app chiusa) -->
        <receiver
            android:name=".notification.ShoppingListActionReceiver"
            android:exported="false" />

        <!-- Riceve l'allarme del promemoria "un colpo solo" per l'intera lista -->
        <receiver
            android:name=".notification.ShoppingReminderReceiver"
            android:exported="false" />

        <!-- Guarda ogni mattina se qualche reso o garanzia sta per scadere -->
        <receiver
            android:name=".notification.ReceiptDeadlineReceiver"
            android:exported="false" />

        <!-- Riposta il promemoria in notifica (se era attivo) dopo un riavvio del telefono -->
        <receiver
            android:name=".notification.ShoppingListBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
